{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "**/*.py", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/ui/(.*)", "dest": "/public/$1" },
    { "src": "/app/ui/(.*)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}